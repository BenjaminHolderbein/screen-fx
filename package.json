{
  "name": "screen-fx",
  "version": "0.1.0",
  "description": "A single-page visual playground — generative effects with layerable post-FX, in one self-contained HTML file.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/BenjaminHolderbein/screen-fx",
  "repository": {
    "type": "git",
    "url": "https://github.com/BenjaminHolderbein/screen-fx.git"
  },
  "private": true,
  "scripts": {
    "dev": "serve -l 5174 .",
    "build": "node build.js",
    "check": "tsc --noEmit -p jsconfig.json && eslint src tests",
    "test:fx": "playwright test",
    "test:fx:update": "playwright test --update-snapshots",
    "postinstall": "xattr -cr node_modules 2>/dev/null || true"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.10.0",
    "serve": "^14.2.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.0"
  }
}
